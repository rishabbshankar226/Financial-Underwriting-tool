{
  "name": "spreadline-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:streamlit": "tsc -b && python3 ../scripts/streamlit_assets.py prepare && vite build --config vite.streamlit.config.ts && python3 ../scripts/streamlit_assets.py write",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:streamlit": "playwright test --config playwright.streamlit.config.ts",
    "test:decimal": "node --test tests/decimal-checks.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@streamlit/component-v2-lib": "0.2.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
